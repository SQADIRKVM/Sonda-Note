# ─── Sonda Note · Next.js dashboard ───
# Copy to apps/web/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Chrome extension id, so the dashboard can push the JWT to the extension.
# Pinned by the "key" field in apps/extension/package.json, so it is the same
# on every machine and after every rebuild.
NEXT_PUBLIC_EXTENSION_ID=edmgnmhmpamhdjocmappgnakfoiblege
