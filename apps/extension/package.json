{
  "name": "sonda-note-extension",
  "displayName": "Sonda Note",
  "version": "1.0.0",
  "description": "Record and transcribe Google Meet calls. Conversational knowledge engine.",
  "author": "Sonda Note",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && node scripts/build-offscreen.mjs",
    "package": "plasmo build --zip && node scripts/build-offscreen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.89.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.24.2",
    "typescript": "5.7.2"
  },
  "manifest": {
    "name": "Sonda Note",
    "permissions": [
      "tabCapture",
      "offscreen",
      "storage",
      "activeTab",
      "scripting",
      "notifications"
    ],
    "host_permissions": [
      "https://meet.google.com/*",
      "https://*.zoom.us/*",
      "https://teams.microsoft.com/*",
      "https://teams.live.com/*",
      "http://localhost:8000/*",
      "http://localhost:8001/*",
      "http://localhost:8002/*",
      "http://localhost:3000/*",
      "http://localhost:3001/*"
    ],
    "externally_connectable": {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:3002/*",
        "https://*.sondanote.com/*"
      ]
    },
    "web_accessible_resources": [
      {
        "resources": [
          "offscreen.html"
        ],
        "matches": [
          "https://meet.google.com/*",
          "https://*.zoom.us/*",
          "https://teams.microsoft.com/*",
          "https://teams.live.com/*"
        ]
      }
    ],
    "key": ""
  }
}