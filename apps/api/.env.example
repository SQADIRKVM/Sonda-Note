# ─── Sonda Note · FastAPI Backend Configuration ───
# Copy this file to apps/api/.env and update values.

# ─── Backend & Database Selection ───
# local    → SQLite + local filesystem (zero external dependencies)
# neon     → Neon.tech Serverless Postgres (100% Free / Production ready)
# supabase → Supabase Hosted Postgres + Auth + Storage
BACKEND=local
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Google Colab GPU Inference Server (100% Free / Zero Paid APIs) ───
# Paste your active Cloudflare tunnel URL from Colab Cell 4 below:
COLAB_GPU_URL=https://your-tunnel-name.trycloudflare.com

# ─── ASR (Speech-to-Text) ───
# colab → Whisper Large V3 on Colab T4 GPU (free, 10x speed, Malayalam + English)
# groq  → Whisper Large V3 via Groq Cloud API
ASR_PROVIDER=colab
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_ASR_MODEL=whisper-large-v3
# Leave blank for auto-detect (Malayalam / English code-mix). Set to "ml" to pin Malayalam.
ASR_LANGUAGE=

# ─── LLM (Meeting Summaries, Action Items & Insights) ───
# colab  → Qwen 2.5:7b via Ollama on Colab T4 GPU (free)
# groq   → llama-3.3-70b-versatile via Groq API
# gemini → gemini-1.5-flash via Google AI Studio API
# ollama → local Ollama on http://localhost:11434
# openai → gpt-4o-mini via OpenAI API
LLM_PROVIDER=colab
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Gemini API (Free tier at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI API / Compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ─── Supabase (Only when BACKEND=supabase) ───
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_AUDIO_BUCKET=meeting-audio

# ─── System & CORS ───
FFMPEG_PATH=ffmpeg
CORS_ORIGINS=["http://localhost:3000"]
